---
import Layout from "../layouts/Layout.astro";
import DevLinkChrome from "../components/DevLinkChrome";
import { getPublishedBlogs } from "../lib/sanity";
import "../devlink/css/global.css";

export const prerender = false;

let blogs: Awaited<ReturnType<typeof getPublishedBlogs>> = [];
try {
  blogs = await getPublishedBlogs();
} catch (error) {
  console.error("Research page: Sanity blogs unavailable", error);
}
---

<Layout title="Research papers | micro1">
  <DevLinkChrome client:only="react" blogs={blogs}>
    <div slot="fallback">Loading…</div>
  </DevLinkChrome>
</Layout>
