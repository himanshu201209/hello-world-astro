---
import Layout from "../layouts/Layout.astro";
import { SiteNav, SiteFooter } from "../components/SiteChrome";
import ResearchHero from "../components/research/ResearchHero.astro";
import ResearchPapers from "../components/research/ResearchPapers.astro";
import FlowModels from "../components/research/FlowModels.astro";
import Micro1Blogs from "../components/research/Micro1Blogs.astro";
import "../devlink/css/global.css";
import "../styles/research-page.css";

export const prerender = false;
---

<Layout title="micro1 research">
  <SiteNav client:only="react">
    <div slot="fallback"></div>
  </SiteNav>

  <main class="page_research">
    <ResearchHero />
    <ResearchPapers />
    <FlowModels />
    <Micro1Blogs />
  </main>

  <SiteFooter client:only="react">
    <div slot="fallback"></div>
  </SiteFooter>
</Layout>

<script src="../scripts/research-page.js"></script>
<script src="../scripts/research-animations.js"></script>
