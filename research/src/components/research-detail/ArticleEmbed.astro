---
/**
 * Renders research-article interactive embeds (widgets, charts, iframes)
 * preserved from the original Micro1 CMS HTML.
 */
interface Props {
  /** Relative path to an HTML fragment under content/research/embeds */
  src?: string;
  /** Direct iframe URL when kind="iframe" */
  kind?: "html" | "iframe";
  title?: string;
}

const { src, kind = "html", title = "Embedded content" } = Astro.props;

let html = "";
if (kind !== "iframe" && src) {
  const modules = import.meta.glob("../../content/research/embeds/*.html", {
    query: "?raw",
    import: "default",
    eager: true,
  }) as Record<string, string>;

  const file = src.split("/").pop() ?? src;
  const match = Object.keys(modules).find(
    (path) => path.endsWith(`/${file}`) || path.endsWith(file)
  );

  if (match) {
    html = modules[match] ?? "";
  }
}
---

{
  kind === "iframe" && src ? (
    <div class="research-detail_embed is-iframe">
      <iframe
        class="research-detail_iframe"
        src={src}
        title={title}
        loading="lazy"
        allowfullscreen
      />
    </div>
  ) : html ? (
    <div class="research-detail_embed" data-research-embed set:html={html} />
  ) : null
}

{
  kind !== "iframe" && html ? (
    <script>
      // Re-run embed scripts (Astro set:html does not execute <script> tags).
      function activateResearchEmbeds() {
        document.querySelectorAll("[data-research-embed]").forEach((root) => {
          if (!(root instanceof HTMLElement)) return;
          if (root.dataset.embedReady === "true") return;
          root.dataset.embedReady = "true";
          root.querySelectorAll("script").forEach((oldScript) => {
            const next = document.createElement("script");
            for (const attr of oldScript.attributes) {
              next.setAttribute(attr.name, attr.value);
            }
            next.textContent = oldScript.textContent;
            oldScript.replaceWith(next);
          });
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", activateResearchEmbeds, {
          once: true,
        });
      } else {
        activateResearchEmbeds();
      }
    </script>
  ) : null
}
