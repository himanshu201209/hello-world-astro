---
import { asset } from "../../lib/asset";

const risoTexture = asset("/research/riso-texture.png");
---

<section class="section_research-hero" aria-labelledby="research-hero-title">
  <div class="research-hero_bg" aria-hidden="true">
    <div class="research-hero_glow is-top">
      <img
        src={asset("/research/hero-glow-top.svg")}
        alt=""
        loading="eager"
      />
    </div>
    <div class="research-hero_glow is-center">
      <div class="research-hero_glow-spin">
        <div class="research-hero_glow-frame">
          <img
            src={asset("/research/hero-glow-center.svg")}
            alt=""
            loading="eager"
          />
        </div>
      </div>
    </div>
    <div class="research-hero_texture">
      <div class="research-hero_texture-rotate">
        <div
          class="research-hero_texture-fill"
          style={`background-image: url("${risoTexture}")`}
        ></div>
      </div>
    </div>
  </div>
  <div class="padding-global">
    <div class="container-research">
      <div class="research-hero_content">
        <h1 id="research-hero-title" class="research-hero_title">micro1 research</h1>
        <p class="research-hero_subtitle">
          Our research mission to drive predictable improvements in intelligence by
          scaling realism and extending the horizon of tasks through real company
          data and product traffic.
        </p>
      </div>
    </div>
  </div>
</section>
